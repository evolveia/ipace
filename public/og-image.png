<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 630" width="1200" height="630">
  <defs>
    <filter id="ogShadow" x="-10%" y="-10%" width="130%" height="130%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#000000" flood-opacity="0.12"/>
    </filter>
    <linearGradient id="ogGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#E4575E"/>
      <stop offset="50%" stop-color="#D2262E"/>
      <stop offset="100%" stop-color="#121212"/>
    </linearGradient>
  </defs>

  <!-- Background #F7F5F2 -->
  <rect width="1200" height="630" fill="#F7F5F2"/>

  <!-- Left: Rotated logo emblem (-6deg) -->
  <g transform="translate(140, 100)">
    <g transform="rotate(-6 160 160)">
      <!-- Outer red rounded border -->
      <rect x="20" y="20" width="280" height="280" rx="60" ry="60" fill="#F7F5F2" stroke="#D2262E" stroke-width="22" filter="url(#ogShadow)"/>
      
      <!-- Watercolor splashes -->
      <path d="M 70 110 C 50 90, 40 130, 60 150 C 45 170, 60 200, 90 190 C 80 210, 120 230, 130 205 C 150 220, 190 210, 175 180 C 200 165, 180 125, 155 130 C 150 100, 110 95, 100 115 Z" fill="#F3BFC3" opacity="0.6"/>
      <path d="M 90 125 C 70 110, 65 140, 80 155 C 70 175, 90 195, 115 185 C 110 200, 140 210, 150 190 C 160 200, 185 190, 175 165 C 185 150, 170 125, 145 130 Z" fill="#E4575E" opacity="0.7"/>
      
      <!-- Splatters -->
      <circle cx="55" cy="100" r="7" fill="#D2262E" opacity="0.8"/>
      <circle cx="45" cy="145" r="9" fill="#E4575E" opacity="0.7"/>
      <circle cx="70" cy="205" r="8" fill="#D2262E" opacity="0.8"/>
      <circle cx="95" cy="225" r="6" fill="#121212" opacity="0.6"/>
      <circle cx="160" cy="220" r="7" fill="#D2262E" opacity="0.7"/>

      <!-- Runner figure -->
      <circle cx="190" cy="100" r="16" fill="#121212"/>
      <path d="M 180 115 C 165 125, 140 145, 135 170 C 150 170, 165 162, 175 150 C 190 138, 192 125, 180 115 Z" fill="url(#ogGrad)"/>
      <path d="M 178 128 L 210 138 L 230 118" stroke="#121212" stroke-width="9" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
      <path d="M 152 135 L 120 145 L 98 168" stroke="#121212" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
      <path d="M 155 165 L 195 185 L 182 230" stroke="#121212" stroke-width="11" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
      <path d="M 178 228 L 198 232" stroke="#D2262E" stroke-width="10" stroke-linecap="round"/>
      <path d="M 138 170 L 105 200 L 82 228" stroke="url(#ogGrad)" stroke-width="11" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
      <path d="M 80 225 L 68 232" stroke="#D2262E" stroke-width="10" stroke-linecap="round"/>
    </g>
  </g>

  <!-- Right: Wordmark "IPACE" + tagline "RUNNING APP" -->
  <g transform="translate(560, 240)">
    <text x="0" y="0" font-family="'Inter', 'Poppins', sans-serif" font-weight="900" font-size="140" fill="#121212" letter-spacing="-2">IPACE</text>
    <text x="5" y="70" font-family="'Inter', 'Poppins', sans-serif" font-weight="700" font-size="42" fill="#5F5B57" letter-spacing="16">RUNNING APP</text>
    <text x="6" y="125" font-family="'Inter', sans-serif" font-weight="500" font-size="24" fill="#D2262E">Plataforma de Corrida &amp; Comunidade com Inteligência Artificial</text>
  </g>

  <!-- Bottom strip: #D2262E with text "Corrida • Comunidade • Eventos • IA" -->
  <rect x="0" y="540" width="1200" height="90" fill="#D2262E"/>
  <text x="600" y="596" font-family="'Inter', 'Poppins', sans-serif" font-weight="700" font-size="28" fill="#FFFFFF" text-anchor="middle" letter-spacing="4">
    CORRIDA • COMUNIDADE • EVENTOS • IA
  </text>
</svg>
